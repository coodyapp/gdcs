{
  "name": "gdcs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://gdcs.coody.app",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build && vp build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.ts",
    "preview": "wrangler pages dev dist",
    "lint": "vp lint . --fix",
    "typecheck": "tsc -b",
    "prepare": "husky",
    "db:migrate:local": "wrangler d1 migrations apply gdcs-prd --local",
    "db:migrate:remote": "wrangler d1 migrations apply gdcs-prd --remote"
  },
  "packageManager": "pnpm@10.15.0",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
    "vite-plus": "0.2.2",
    "wrangler": "4.140.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
      "vitest": "4.1.9"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    }
  }
}
