{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gdcs-mailer-prd-01",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // Internal only: reached through the Pages service binding and cron.
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    // Mondays 14:00 UTC. Sends only when sheets changed since the last digest.
    "crons": ["0 14 * * 1"],
  },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdcs-prd",
      "database_id": "992ce841-dd51-477c-8014-bf36fdb096fc",
      "migrations_dir": "../../migrations",
    },
  ],
  "vars": {
    "SITE_URL": "https://gdcs.coody.app",
    "FROM_EMAIL": "gdcs@mail.coody.app",
    "FROM_NAME": "GDCS updates",
  },
  "observability": { "enabled": true },
}
