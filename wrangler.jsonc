{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gdcs-prd-01",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "upload_source_maps": true,
  // Prerendered site. Hashed files and images skip the Worker; pages and /api/*
  // run it (see worker/page.ts).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/assets/*", "!/posters/*", "!/og/*"],
  },
  // Production hostname (Workers custom domain; Cloudflare manages its DNS).
  "routes": [{ "pattern": "gdcs.coody.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    // Mondays 14:00 UTC. Sends only when sheets changed since the last digest.
    "crons": ["0 14 * * 1"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gdcs-prd",
      "database_id": "992ce841-dd51-477c-8014-bf36fdb096fc",
      "migrations_dir": "migrations",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SITE_URL": "https://gdcs.coody.app",
    "FROM_EMAIL": "gdcs@mail.coody.app",
    "FROM_NAME": "GDCS updates",
  },
  "observability": { "enabled": true },
}
